# =========================
# APPLICATION
# =========================
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5005
SECRET_KEY=replace_with_secure_random_value
# Historical alias accepted by the backend:
FLASK_SECRET_KEY=
DEMO_MODE=false
AUTO_SEED=false
FRONTEND_ORIGIN=http://localhost:3005
APP_BASE_URL=http://localhost:3005
SESSION_COOKIE_SECURE=false
AUTH_SESSION_LIFETIME_DAYS=30
RATELIMIT_STORAGE_URI=memory://
# Device approval policy. Superadmin is always exempt server-side.
DEVICE_ACCESS_MODE=approved_devices_only
DEVICE_COOKIE_NAME=moneda_device
SUPERADMIN_EMERGENCY_ACCESS_ENABLED=false
SUPERADMIN_EMERGENCY_KEY=
SUPERADMIN_EMERGENCY_KEY_HASH=

# =========================
# MONGODB
# =========================
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/moneda?retryWrites=true&w=majority
MONGODB_DATABASE=moneda

# =========================
# EMAIL - ZOHO MAIL API (OAuth 2.0; no SMTP dependency)
# =========================
EMAIL_PROVIDER=zoho_mail_api
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
ZOHO_OAUTH_REDIRECT_URI=http://localhost:5005/api/v1/integrations/zoho/callback
ZOHO_MAIL_API_BASE_URL=
ZOHO_FROM_ADDRESS=business@monedatechnologies.com
INTEGRATION_ENCRYPTION_KEY=

# From identities on the single authenticated Zoho mailbox (not credentials)
MAIL_OTP_FROM=otp@monedatechnologies.com
MAIL_OTP_FROM_NAME=Moneda OTP
MAIL_QUOTATION_FROM=quotations@monedatechnologies.com
MAIL_QUOTATION_FROM_NAME=Moneda Quotations
MAIL_ORDER_FROM=orders@monedatechnologies.com
MAIL_ORDER_FROM_NAME=Moneda Orders
MAIL_GENERAL_FROM=business@monedatechnologies.com
MAIL_GENERAL_FROM_NAME=Moneda Technologies

# Customer-facing quotation/order routing. Disabled recipients remain inactive.
MAIL_CUSTOMER_CC_BUSINESS=business@monedatechnologies.com
MAIL_CUSTOMER_CC_VBHUTA=vbhuta@monedatechnologies.com
MAIL_CUSTOMER_CC_VBHUTA_ENABLED=false
MAIL_CUSTOMER_CC_ADMIN=admin@monedatechnologies.com
MAIL_CUSTOMER_CC_ADMIN_ENABLED=false
MAIL_CUSTOMER_BCC_OPERATIONS=operations@chemo.in
MAIL_CUSTOMER_BCC_OPERATIONS_ENABLED=true

MAIL_TEST_TO=

# =========================
# EXCHANGE RATES
# =========================
EXCHANGE_RATE_PROVIDER=frankfurter
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_CACHE_SECONDS=21600

# =========================
# TRUSTED DEVICE LOCATION (approximate network location only)
# =========================
TRUSTED_PROXY_IPS=
IP_GEO_PROVIDER=ipinfo
IP_GEO_DATABASE_PATH=
IP_GEO_API_KEY=
IP_GEO_CACHE_SECONDS=86400

# =========================
# WHATSAPP
# =========================
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# =========================
# STORAGE
# =========================
UPLOAD_DIRECTORY=./uploads
PDF_DIRECTORY=./generated/quotations
PDF_RENDERER=reportlab
DATA_DIRECTORY=./data

# Initial secure setup (used by backend/manage.py create-superadmin)
INITIAL_SUPERADMIN_EMAIL=owner@example.com
INITIAL_SUPERADMIN_NAME=Moneda Administrator
INITIAL_SUPERADMIN_PHONE=

# Frontend branding path; replace the asset without changing application code
VITE_BRAND_LOGO_PATH=/brand/moneda-logo.svg
VITE_API_BASE_URL=/api/v1
VITE_API_ORIGIN=
VITE_API_PROXY_TARGET=http://127.0.0.1:5005
VITE_PORT=3005
